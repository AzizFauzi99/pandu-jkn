# auth (JWT_SECRET wajib; buat dengan: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET = your_random_secret
JWT_EXPIRE_MINUTES = 60

# origin frontend yang diizinkan CORS (pisahkan dengan koma, default semua)
FRONTEND_ORIGINS = http://localhost:5173

# postgres (user read-only, data sampel BPJS)
DATABASE_URL = postgresql://user:password@host:5432/bpjs_data
# postgres (user yang boleh menulis, untuk tabel users)
DATABASE_ADMIN = postgresql://user:password@host:5432/bpjs_data

# openai
OPENAI_MODEL = gpt-6-luna
OPENAI_API_KEY = your_api_key_openai
